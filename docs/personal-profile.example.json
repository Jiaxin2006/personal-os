    {"id": "social", "bar_label": "Admin", "name": "行政与杂务", "counts_as_work": true, "archived": false},
    {"id": "other_work", "bar_label": "Misc", "name": "其他工作", "counts_as_work": true, "archived": false},
    {"id": "reading", "bar_label": "Reading", "name": "阅读", "counts_as_work": false, "archived": false},
